{
  "name": "torvath-homepage",
  "description": "Torvath marketing site — TanStack Start, prerendered multi-page, Tailwind v4.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "node dist/server/node.js",
    "start": "node dist/server/node.js",
    "start:bun": "bun dist/server/bun.js",
    "start:deno": "deno run --allow-net --allow-read --allow-env dist/server/deno.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-start": "^1.168.48",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}

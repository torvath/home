# Public origin. Used for sitemap <loc> entries at build time.
SITE_URL=https://torvath.com

# Same origin, exposed to the browser bundle for canonical URLs, Open Graph
# tags and JSON-LD. Keep it identical to SITE_URL.
VITE_SITE_URL=https://torvath.com

# Where contact-form submissions are delivered.
CONTACT_TO=hello@torvath.com

# Cloudflare Web Analytics site token (Dashboard → Web Analytics → your site).
# Cookieless and consent-free. Leave empty in dev: the beacon is only emitted
# in production builds, and only when this is set.
# Changing analytics providers means updating src/content/legal.ts too.
VITE_CF_BEACON_TOKEN=

# Search Console / Bing verification, if verifying by meta tag instead of DNS.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# node | bun | deno | none — chooses which host adapter `vite build` emits.
DEPLOY_TARGET=node

# Resend API key (dashboard.resend.com/api-keys). Contact-form emails are
# skipped with a warning when this is empty — safe to leave blank in dev.
RESEND_API_KEY=

# Verified Resend sender. Must be on a domain you've verified in Resend, e.g.
# "Torvath <hello@torvath.com>". Falls back to the unverified onboarding@resend.dev
# test sender, which only delivers to your own Resend account email.
RESEND_FROM=
